{
  "name": "yodha-mobile-dev-agent",
  "displayName": "Yodha Mobile Developer",
  "description": "AI mobile developer: Swift/SwiftUI, Kotlin/Compose, React Native",
  "version": "0.1.0",
  "publisher": "yodha",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "yodha",
    "mobile-dev"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "languageModels": "true"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "yodha.mobile-dev",
        "name": "yodha-mobile",
        "fullName": "Yodha Mobile Developer",
        "description": "AI mobile developer: Swift/SwiftUI, Kotlin/Compose, React Native",
        "isSticky": false,
        "commands": [
          {
            "name": "help",
            "description": "Show Mobile Developer capabilities"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Yodha Mobile Developer",
      "properties": {
        "yodha-mobile-dev.aiProvider": {
          "type": "string",
          "enum": [
            "vscode",
            "claude",
            "openai"
          ],
          "enumDescriptions": [
            "VS Code built-in LLM via GitHub Copilot (no API key needed)",
            "Anthropic Claude (requires claudeApiKey)",
            "OpenAI GPT-4 (requires openaiApiKey)"
          ],
          "default": "vscode",
          "description": "AI provider for this agent"
        },
        "yodha-mobile-dev.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic Claude API key (sk-ant-...)"
        },
        "yodha-mobile-dev.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key (sk-...)"
        },
        "yodha-mobile-dev.claudeModel": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "Claude model to use"
        },
        "yodha-mobile-dev.openaiModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "OpenAI model to use"
        },
        "yodha-mobile-dev.vscodeModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "VS Code LLM model family (e.g. gpt-4o, gpt-4o-mini)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}